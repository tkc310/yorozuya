{
  "name": "yorozu-ya",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vp dev --host 127.0.0.1 --port 4628",
    "build:app": "bun scripts/app/build.ts",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --no-open",
    "prepare": "panda codegen && lefthook install",
    "test": "vp test --run",
    "test:e2e": "playwright test",
    "typecheck": "bun check",
    "lint": "vp lint && pnpm lint:boundary",
    "fmt": "vp fmt --check",
    "lint:boundary": "NODE_OPTIONS='--require ./scripts/eslint-typescript6.cjs' eslint . && node scripts/check-advanced-boundaries.mjs"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "drizzle-orm": "^0.45.4",
    "neverthrow": "^8.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "valibot": "^1.5.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@pandacss/dev": "^2.2.0",
    "@pandacss/preset-base": "2.2.0",
    "@playwright/test": "^1.64.1",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.3.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.71.2",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "happy-dom": "^21.0.3",
    "lefthook": "^2.2.2",
    "postcss": "^8.5.6",
    "storybook": "^10.6.2",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "^1.3.0",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  }
}
