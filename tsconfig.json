{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["bun", "vite/client"],
    "isolatedModules": true,
    "paths": {
      "styled-system/*": ["./styled-system/*"]
    }
  },
  "include": [
    "src",
    "shared",
    "vite.config.ts",
    "panda.config.ts",
    "playwright.config.ts",
    ".storybook"
  ]
}
